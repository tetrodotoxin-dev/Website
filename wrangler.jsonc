{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tetrodotoxin-dev",
  "compatibility_date": "2026-08-26",
  "routes": [
    {
      "pattern": "tetrodotoxin.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
