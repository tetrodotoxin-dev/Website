---
import { footerNavigation, SITE } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <a class="footer-brand" href="/" aria-label="Tetrodotoxin home">
      <img src="/brand/icon.svg" alt="" />
      <div>
        <strong>{SITE.name}</strong>
        <span>The common layer is meaning, not representation.</span>
      </div>
    </a>

    <nav aria-label="Footer navigation">
      {footerNavigation.map((item) => (
        <a href={item.href}>
          {'icon' in item && <span aria-hidden="true">{item.icon} </span>}{item.label}
        </a>
      ))}
      <a href={SITE.organization}>GitHub organization</a>
    </nav>
  </div>

  <div class="container footer-meta">
    <span>Copyright © 2023-present Matt Kaes and contributors</span>
    <span>{SITE.domain}</span>
  </div>
</footer>
