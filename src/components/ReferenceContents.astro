---
import {
  findNode,
  graphNodes,
  navigableNodes,
  nodeHref,
  referenceRouteTree,
  type ReferenceGraph,
} from '../data/reference';
import ReferenceRouteTree from './ReferenceRouteTree.astro';

interface Props {
  graph: ReferenceGraph;
}

const { graph } = Astro.props;
const dialect = findNode(graph.dialect);
const root = findNode(graph.root);
const routes = referenceRouteTree(graph);
---

<div class="reference-package-contents">
  <section class="reference-monograph-group">
    <h3>Package identity</h3>
    <dl class="reference-relationships">
      <div><dt>Package</dt><dd><a href={nodeHref(root)}>{root.displayName}</a></dd></div>
      <div><dt>Language</dt><dd><a href={nodeHref(dialect)}>{dialect.displayName}</a></dd></div>
      <div><dt>Source</dt><dd><code>{graph.displaySource}</code></dd></div>
      <div><dt>Surface</dt><dd>{graphNodes(graph).length} Abstracts · {navigableNodes(graph).length} routes</dd></div>
    </dl>
  </section>

  <section class="reference-monograph-group">
    <h3>Package routes</h3>
    <ReferenceRouteTree branches={routes} pathname={Astro.url.pathname} />
  </section>
</div>
