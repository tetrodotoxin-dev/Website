---
import {
  packageReferenceHref,
  sourceAnchor,
  type ReferencePackage,
} from '../data/reference';

interface Props {
  document: ReferencePackage;
}

const { document } = Astro.props;
const sources = document.sources.filter((source) => source.id !== document.package.root);
const groups = sources.reduce<Array<{ dialect: string; sources: typeof sources }>>((result, source) => {
  const group = result.find((candidate) => candidate.dialect === source.dialect);
  if (group) {
    group.sources.push(source);
  } else {
    result.push({ dialect: source.dialect, sources: [source] });
  }
  return result;
}, []);
const dependencies = [...new Map(
  document.edges
    .filter((edge) => edge.kind === 'package-import')
    .map((edge) => [`${edge.target.package}@${edge.target.major}.${edge.target.minor}`, edge.target]),
).values()];
---

<div class="reference-package-contents">
  {
    groups.map((group) => (
      <section class="reference-monograph-group" aria-labelledby={`monograph-${group.dialect.toLowerCase()}`}>
        <h3 id={`monograph-${group.dialect.toLowerCase()}`}>{group.dialect}</h3>
        <div class="reference-capsule-list">
          {group.sources.map((source) => (
            <a class="reference-source-capsule" href={`#${sourceAnchor(source.id)}`}>{source.path}</a>
          ))}
        </div>
      </section>
    ))
  }

  <section class="reference-monograph-group reference-dependency-group" aria-labelledby="package-dependencies">
    <h3 id="package-dependencies">Dependencies</h3>
    <div class="reference-capsule-list">
      {
        dependencies.length > 0
          ? dependencies.map((dependency) => (
              <a class="reference-dependency-capsule" href={packageReferenceHref(dependency.package)}>
                <span>{dependency.package}</span>
                <small>{dependency.major}.{dependency.minor}</small>
              </a>
            ))
          : <span class="reference-empty-capsule">None</span>
      }
    </div>
  </section>
</div>
