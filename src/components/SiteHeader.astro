---
import { primaryNavigation, SITE } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Tetrodotoxin home">
      <img class="brand-wordmark" src="/brand/logo.svg" alt="" />
      <img class="brand-icon" src="/brand/icon.svg" alt="" />
    </a>

    <nav class="primary-navigation" aria-label="Primary navigation">
      {
        primaryNavigation.map((item) => (
          <a
            class:list={{ 'navigation-icon-link': 'iconOnly' in item }}
            href={item.href}
            aria-label={'iconOnly' in item ? item.label : undefined}
            aria-current={isActive(item.href) ? 'page' : undefined}
            title={'iconOnly' in item ? item.label : undefined}
          >
            {'icon' in item && <span class="navigation-icon" aria-hidden="true">{item.icon}</span>}
            {!('iconOnly' in item) && <span class="navigation-label">{item.label}</span>}
          </a>
        ))
      }
      <a class="github-link" href={SITE.github}>
        GitHub
      </a>
    </nav>
  </div>
</header>
