---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Download Tetrodotoxin"
  description="Find Tetrodotoxin source, releases, and release notes on GitHub."
>
  <main id="main" class="simple-page">
    <div class="container">
      <section class="release-panel">
        <div class="release-heading">
          <div>
            <p class="subheader">Downloads</p>
            <h1>Get Tetrodotoxin from GitHub</h1>
          </div>
          <div class="release-icon">
            <img src="/brand/icon.svg" alt="" />
          </div>
        </div>
        <p class="release-summary">
          The Puffer SDK release keeps the bootstrap executable, standard
          Dialect and Terminal plugins, Package repository, native providers,
          and VS Code extension together. Use Releases for that complete SDK or
          browse the repository to contribute to its owners.
        </p>
        <p class="release-summary">
          After downloading the Puffer SDK, follow the <a href="/docs/getting-started/">Getting started documentation</a> to build and run the Echo example.
        </p>
        <div class="button-row release-actions">
          <a class="button button-primary" href={SITE.releases}>
            View GitHub releases
          </a>
          <a class="button button-secondary" href={SITE.github}>
            Browse the source
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
