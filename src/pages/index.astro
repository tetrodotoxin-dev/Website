---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import { SITE } from '../data/site';

const principles = [
  {
    title: 'Keep meaning with its language',
    copy: 'Scenes keep lifecycle, shaders keep GPU behavior, and build descriptions keep infrastructure policy, so cooperation does not flatten those ideas into one generic model.',
  },
  {
    title: 'Let every tool ask the same owner',
    copy: 'Editors, compilers, package tools, and runtimes work from the same semantic identities instead of synchronizing their own copies of the program.',
  },
  {
    title: 'Generate each representation when needed',
    copy: 'Native code, GPU modules, reusable packages, bindings, and tooling views remain independent outputs for the consumers that need them.',
  },
];

const surfaces = [
  {
    label: 'Language',
    title: 'Keep specialized language design',
    copy: 'Whether using a bundled language or bringing an existing one, each keeps the grammar and semantics that make it useful while participating in the same product.',
  },
  {
    label: 'Tools',
    title: 'Reuse one understanding',
    copy: 'A name, relationship, or incomplete declaration stays connected to its real owner, so editors and compilers do not need parallel symbol and dependency models.',
  },
  {
    label: 'Outputs',
    title: 'Serve each consumer honestly',
    copy: 'A compiler, binding generator, package publisher, or custom tool derives the representation its consumer needs without making every language adopt it.',
  },
];
---

<BaseLayout
  title={SITE.title}
  description="Purpose-built languages sharing one living semantic Workspace and one connected toolchain."
>
  <main id="main">
    <section class="hero">
      <div class="container hero-content">
        <div class="hero-heading">
          <p class="subheader">A language platform for whole products</p>
          <h1 class="two-tone-title">
            <span>Purpose-built languages</span>
            <span>One connected toolchain</span>
          </h1>
        </div>

        <div class="hero-support">
          <div class="hero-copy">
            <p class="hero-summary">
              Tetrodotoxin is a platform for building software from several
              purpose-built languages without assembling a separate toolchain
              around each one. Source code, editor tools, packages, compilers,
              and runtimes work from the same understanding of the program
              instead of maintaining their own copies. Use the included
              language family or bring an existing language, then produce
              native applications, GPU programs, bindings, and reusable
              packages through one connected system.
            </p>
            <div class="button-row">
              <a class="button button-primary" href="/docs/getting-started/">
                Getting Started
              </a>
              <a class="button button-secondary" href="/docs/design/">
                Understand why
              </a>
            </div>
          </div>

          <HeroDiagram
            label="Connected toolchain"
            description="Purpose-built languages contribute meaning to one shared understanding, which independent tools turn into the outputs their consumers need."
            connectors={['share meaning', 'produce independently']}
            layers={[
              { kind: 'nodes', items: ['Application', 'Scene', 'Shader', 'Build description'] },
              {
                kind: 'content',
                eyebrow: 'One connected understanding',
                title: 'Living semantic graph',
                detail: 'Identity · Relationships · Partial meaning',
              },
              { kind: 'nodes', items: ['Executable', 'GPU module', 'Reusable package', 'Bindings'] },
            ]}
          />
        </div>
      </div>
    </section>

    <section class="section section-bordered section-end-compact">
      <div class="container section-heading">
        <h2>Specialization without fragmentation</h2>
        <p>
          A domain should not have to choose between a generic data file and an
          isolated toolchain. Tetrodotoxin lets concrete languages keep their
          own meaning while their tools meet around the parts they genuinely
          share.
        </p>
      </div>

      <div class="container grid columns-3 section-content">
        {
          principles.map((principle) => (
            <article class="card card-plain">
              <h3 class="accent">{principle.title}</h3>
              <p>{principle.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <p class="container subheader">Extension without reinvention</p>
      <div class="container section-heading section-heading-split">
        <div>
          <h2 class="two-tone-title">
            <span>Bring a language</span>
            <span>Reuse the toolchain</span>
          </h2>
        </div>
        <p>
          A language contributes the meaning it owns so editors, package tools,
          compilers, and runtimes can reuse it without translating the complete
          language into another common model.
        </p>
      </div>

      <div class="container grid columns-3 section-content">
        {
          surfaces.map((surface) => (
            <article class="card">
              <span>{surface.label}</span>
              <h3>{surface.title}</h3>
              <p>{surface.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="integration" class="section section-bordered">
      <p class="container subheader">Infrastructure is authored too</p>
      <div class="container section-heading section-heading-split">
        <div>
          <h2 class="two-tone-title">
          <span>Describe the product</span>
          <span>Configure its production</span>
          </h2>
        </div>
        <p>
          Tetrodotoxin gives each role a precise name. A Package describes the
          host-independent product, while a Build selects what one invocation
          should create from the providers, target, repositories, and confined
          output paths supplied by its Environment. Tetrodotoxin calls an
          installed language a Dialect, the living graph for one product a
          Workspace, and an independent output provider a Terminal so these
          responsibilities remain separate owners rather than modes in one
          compiler driver.
        </p>
      </div>

      <div
        class="container diagram inset-shadow pipeline-diagram"
        aria-label="Package and Build sources enter one Environment configured Workspace and feed independent Terminal products"
      >
        <div class="pipeline-stage pipeline-inputs">
          <p>Authored roots</p>
          <div class="diagram-panel pipeline-node">
            <small>Package Dialect</small>
            <strong>package.ttx</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Build Dialect</small>
            <strong>build.ttx</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Invocation input</small>
            <strong>Dialect-owned arguments</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Puffer SDK</small>
            <strong>Explicit provider plugins</strong>
          </div>
        </div>

        <div class="diagram-arrow" aria-hidden="true">→</div>

        <div class="diagram-panel accent-panel pipeline-core">
          <small>Environment-owned toolchain</small>
          <strong>Living Package Workspace</strong>
          <span>Semantic graph · Requested products · Selected providers</span>
        </div>

        <div class="diagram-arrow" aria-hidden="true">→</div>

        <div class="pipeline-stage pipeline-outputs">
          <p>Terminal products</p>
          <div class="diagram-panel pipeline-node">
            <small>Native provider</small>
            <strong>Executable or library</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Vulkan</small>
            <strong>SPIR-V + pipeline description</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Package Terminal</small>
            <strong>Source-free semantic graph</strong>
          </div>
          <div class="diagram-panel pipeline-node">
            <small>Custom Terminal</small>
            <strong>Image, data, or another format</strong>
          </div>
        </div>
      </div>

      <div class="container grid columns-3 section-content">
        <article class="card card-plain">
          <small>Host-independent grouping</small>
          <p>
            Package owns coordinates, dependencies, exports, resources, and the
            machinery needed to reconstruct its semantic graph without source.
          </p>
        </article>
        <article class="card card-plain">
          <small>Build + Environment as code</small>
          <p>
            Build maps invocation inputs to exact product providers while
            Environment owns plugins, repositories, targets, and confined
            publication roots.
          </p>
        </article>
        <article class="card card-plain">
          <small>Terminal outputs</small>
          <p>
            Generate images, data files, reports, archives, or any other format
            a Terminal can derive without teaching every Dialect about that
            representation.
          </p>
        </article>
      </div>

      <div class="container ecosystem-panel">
        <div>
          <p class="subheader">One installed Puffer SDK</p>
          <h3>Bootstrap explicitly, then replace any provider</h3>
          <p>
            The SDK supplies bootstrap Build, Environment, and Package Dialects
            alongside standard provider plugins, Packages, the native runtime,
            and the VS Code extension. Because a starter Build imports only the
            providers it uses, another plugin can satisfy the same semantic
            contract without changing Puffer.
          </p>
        </div>
        <div class="chip-grid ecosystem-tools" aria-label="Existing toolchain integrations">
          <span>Build</span>
          <span>Environment</span>
          <span>Package</span>
          <span>LLVM</span>
          <span>Vulkan</span>
          <span>VS Code</span>
        </div>
      </div>
    </section>

    <section class="section section-bordered">
      <div class="container section-heading">
        <h2 class="two-tone-title">
          <span>Build something first</span>
          <span>Follow the model as far as you want</span>
        </h2>
      </div>
      <div class="container grid columns-2 homepage-paths section-content">
        <article class="card homepage-path">
          <p class="subheader">Start with a product</p>
          <h2>Build the first application</h2>
          <p>
            Install the Puffer SDK, inspect the four small project sources, and
            publish a native application with <code>puffer build.ttx</code>.
          </p>
          <a class="button button-primary" href="/docs/getting-started/">
            Getting Started
          </a>
        </article>

        <article class="card homepage-path">
          <p class="subheader">Expand the Foundation</p>
          <h2>Bootstrap from scratch</h2>
          <p>
            Learn the ownership rules, repository boundaries, and evidence
            expected when a contribution carries the graph closer to the
            documented architecture.
          </p>
          <a class="button button-secondary" href="/docs/development/">
            Contribute
          </a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
