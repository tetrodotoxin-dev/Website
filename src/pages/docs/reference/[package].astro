---
import ReferenceContents from '../../../components/ReferenceContents.astro';
import ReferenceLayout from '../../../layouts/ReferenceLayout.astro';
import {
  documentationParagraphs,
  findNode,
  graphNodes,
  referenceGraphs,
  type ReferenceGraph,
} from '../../../data/reference';

interface Props { graph: ReferenceGraph }

export function getStaticPaths() {
  return referenceGraphs.map((graph) => ({ params: { package: graph.slug }, props: { graph } }));
}

const { graph } = Astro.props;
const root = findNode(graph.root);
const paragraphs = documentationParagraphs(root.documentation);
---

<ReferenceLayout
  title={root.displayName}
  description={paragraphs[0] ?? `${graphNodes(graph).length} Abstracts in ${root.displayName}.`}
  activeGraph={graph.slug}
>
  <section class="reference-graph-overview" aria-labelledby="graph-contents-heading">
    <div class="reference-section-heading">
      <div><span class="reference-kind">Graph text version 1</span><h2 id="graph-contents-heading">Package contents</h2></div>
      <p>Expand each Package route to follow its semantic owner one layer at a time.</p>
    </div>
    <div class="reference-package-contents-panel"><ReferenceContents graph={graph} /></div>
  </section>

  <footer class="reference-next-package"><a href="/docs/reference/">← All Packages</a></footer>
</ReferenceLayout>
