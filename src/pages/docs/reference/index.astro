---
import ReferenceLayout from '../../../layouts/ReferenceLayout.astro';
import {
  documentationParagraphs,
  findNode,
  graphHref,
  graphNodes,
  navigableNodes,
  referenceGraphs,
} from '../../../data/reference';

const totals = referenceGraphs.reduce((result, graph) => ({
  nodes: result.nodes + graphNodes(graph).length,
  routes: result.routes + navigableNodes(graph).length,
}), { nodes: 0, routes: 0 });
---

<ReferenceLayout
  title="TTX Package reference"
  description="Generated Package identities and their live semantic routes, rendered directly from versioned graph text."
>
  <section class="reference-introduction" aria-labelledby="reference-about">
    <h2 id="reference-about">The Package graph is the documentation source</h2>
    <p>
      Each dump records real Abstract identities, concepts, contracts, Type relationships, and ordered Layouts.
      The website applies no Dialect-specific schema or semantic reconstruction.
    </p>
    <div class="reference-totals" aria-label="Reference totals">
      <span><strong>{referenceGraphs.length}</strong> Packages</span>
      <span><strong>{totals.nodes}</strong> Abstracts</span>
      <span><strong>{totals.routes}</strong> concept paths</span>
    </div>
  </section>

  <section class="reference-package-list" aria-labelledby="reference-packages">
    <h2 id="reference-packages">Packages</h2>
    <div class="grid columns-2">
      {referenceGraphs.map((graph) => {
        const root = findNode(graph.root);
        const summary = documentationParagraphs(root.documentation)[0];
        return (
          <a class="card reference-package-card" href={graphHref(graph)}>
            <span class="reference-version">Package graph · version 1</span>
            <h3>{root.displayName}</h3>
            {summary && <p>{summary}</p>}
            <small>{graphNodes(graph).length} Abstracts · {navigableNodes(graph).length} routes</small>
            <span class="reference-card-action">Open Package <span aria-hidden="true">→</span></span>
          </a>
        );
      })}
    </div>
  </section>
</ReferenceLayout>
