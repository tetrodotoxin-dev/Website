---
import ReferenceLayout from '../../../layouts/ReferenceLayout.astro';
import { isReferenceType, packageReferenceHref, referencePackages } from '../../../data/reference';

const totals = referencePackages.reduce(
  (summary, document) => {
    summary.sources += document.sources.length;
    summary.types += document.nodes.filter(isReferenceType).length;
    return summary;
  },
  { sources: 0, types: 0 },
);
---

<ReferenceLayout
  title="TTX package reference"
  description="Public language and runtime APIs projected from completed TTX semantic graphs."
  subheader="Generated from source"
>
  <section class="reference-introduction" aria-labelledby="reference-about">
    <h2 id="reference-about">The source graph is the documentation source</h2>
    <p>
      Puffer interprets each Package with the same Dialects and Workspace used for compilation, then a
      Documentation Terminal serializes its public identities and their real semantic relationships into a
      stable graph product. The website presents that graph without parsing TTX or maintaining another symbol model.
    </p>
    <div class="reference-totals" aria-label="Reference totals">
      <span><strong>{referencePackages.length}</strong> packages</span>
      <span><strong>{totals.sources}</strong> sources</span>
      <span><strong>{totals.types}</strong> public types</span>
    </div>
  </section>

  <section class="reference-package-list" aria-labelledby="reference-packages">
    <h2 id="reference-packages">Package reference</h2>
    <div class="reference-package-grid">
      {
        referencePackages.map((document) => {
          return (
            <a class="reference-package-card" href={packageReferenceHref(document.package.name)}>
              <span class="reference-version">Version {document.package.major}.{document.package.minor}</span>
              <h3>{document.package.name}</h3>
              <p>{document.sources.length} sources · {document.nodes.filter(isReferenceType).length} public types</p>
              <span class="reference-card-action">Open reference <span aria-hidden="true">→</span></span>
            </a>
          );
        })
      }
    </div>
  </section>
</ReferenceLayout>
