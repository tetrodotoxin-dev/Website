---
import ReferenceLayout from '../../../../layouts/ReferenceLayout.astro';
import {
  documentationParagraphs,
  findNode,
  graphHref,
  graphNodes,
  nodeHref,
  nodeLayouts,
  referenceGraphs,
  type ReferenceGraph,
  type ReferenceNode,
} from '../../../../data/reference';

interface Props { graph: ReferenceGraph; node: ReferenceNode }

export function getStaticPaths() {
  return referenceGraphs.flatMap((graph) => graphNodes(graph).map((node) => ({
    params: { package: graph.slug, type: node.slug },
    props: { graph, node },
  })));
}

const { graph, node } = Astro.props;
const resolved = findNode(node.resolved);
const type = findNode(node.type);
const packageRoot = findNode(graph.root);
const layouts = nodeLayouts(node);
const paragraphs = documentationParagraphs(node.documentation);
const title = node.route || node.displayName;
const description = paragraphs[0] ?? `${node.displayName} implements ${node.contracts.join(', ')}.`;
---

<ReferenceLayout title={title} description={description} activeGraph={graph.slug}>
  <nav class="reference-breadcrumbs" aria-label="Breadcrumb">
    <a href="/docs/reference/">Reference</a><span aria-hidden="true">/</span>
    <a href={graphHref(graph)}>{packageRoot.displayName}</a><span aria-hidden="true">/</span>
    <span>{title}</span>
  </nav>

  <section class="reference-type-introduction">
    <p><span class="reference-kind">dump-local ID {node.id}</span> <code>{node.displayName}</code></p>
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <div class="reference-capsule-list">
      {node.contracts.map((contract) => <span class="reference-empty-capsule">{contract}</span>)}
    </div>
  </section>

  <section class="reference-type-section" aria-labelledby="relationships">
    <h2 id="relationships">Relationships</h2>
    <dl class="reference-relationships reference-type-relationships">
      <div><dt>resolve</dt><dd><a href={nodeHref(resolved)}>{resolved.displayName}</a></dd></div>
      <div><dt>Type</dt><dd><a href={nodeHref(type)}>{type.displayName}</a></dd></div>
      <div><dt>canonical path</dt><dd><code>{node.route || '(root or non-concept edge)'}</code></dd></div>
      <div><dt>name bytes</dt><dd><code>{node.name || '(empty)'}</code></dd></div>
    </dl>
  </section>

  <section class="reference-type-section" aria-labelledby="concepts">
    <h2 id="concepts">Concepts</h2>
    {node.concepts.length > 0 ? (
      <div class="reference-alias-list">
        {node.concepts.map((concept) => {
          const target = findNode(concept.target);
          return <div><code>{concept.displayName}</code><a href={nodeHref(target)}>{target.displayName} <span aria-hidden="true">→</span></a></div>;
        })}
      </div>
    ) : <p>No concepts were advertised in this snapshot.</p>}
  </section>

  {layouts.map((layout) => (
    <section class="reference-type-section" aria-labelledby={`layout-${layout.role}`}>
      <h2 id={`layout-${layout.role}`}>{layout.role[0].toUpperCase()}{layout.role.slice(1)} Layout</h2>
      {layout.entries.length > 0 ? (
        <div class="reference-members">
          {layout.entries.map((entry) => {
            const target = entry.target ? findNode(entry.target) : null;
            return (
              <article class="reference-member">
                <header><h3>{entry.displayName || `entry ${entry.index}`}</h3><span>ordered slot {entry.index}</span></header>
                <p class="reference-member-type"><span>Abstract</span>{target ? <a href={nodeHref(target)}>{target.displayName}</a> : <code>none</code>}</p>
              </article>
            );
          })}
        </div>
      ) : <p>This Layout contains no value-flow entries.</p>}
    </section>
  ))}
</ReferenceLayout>
