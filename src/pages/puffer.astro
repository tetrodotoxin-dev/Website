---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const capabilities = [
  {
    label: 'Editor',
    title: 'One live language server',
    copy: 'Diagnostics, hover, navigation, completion, semantic highlighting, and formatting ask the same Workspace that understands the build.',
  },
  {
    label: 'Build',
    title: 'One compiler front door',
    copy: 'A Package request resolves sources and dependencies, selects Terminals and Linker products, and publishes the complete result transactionally.',
  },
  {
    label: 'Sessions',
    title: 'One Workspace host',
    copy: 'Command line, editor, and build-system requests share the same language, Package, compilation, linking, and Archive behavior.',
  },
];
---

<BaseLayout
  title="Puffer · The complete Tetrodotoxin application"
  description="Puffer is Tetrodotoxin's all-in-one compiler driver, Workspace host, command interface, and language server."
>
  <main id="main">
    <section class="product-hero">
      <div class="container product-hero-grid">
        <div>
          <p class="subheader">The all-in-one implementation</p>
          <h1>One front door for the whole toolchain.</h1>
          <p class="product-summary">
            Puffer is how people and build systems enter Tetrodotoxin. Its
            command line turns Packages into finished products, while its
            language server gives editors a live understanding of the same
            sources.
          </p>
          <div class="button-row">
            <a class="button button-primary" href={SITE.puffer}>
              Browse Puffer
              <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href="/docs/core-concepts/">
              Understand the platform
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="puffer-journey" aria-label="Editor, command line, and build system requests enter a Puffer session, use Tetrodotoxin owners, and return diagnostics or completed products">
          <div class="puffer-inputs">
            <span>Editor</span>
            <span>Command line</span>
            <span>Build system</span>
          </div>
          <div class="puffer-arrow" aria-hidden="true">↓</div>
          <div class="puffer-session">
            <small>Process + transport + presentation</small>
            <strong>Puffer session</strong>
          </div>
          <div class="puffer-arrow" aria-hidden="true">↓</div>
          <div class="puffer-owners">
            <span>Workspace</span>
            <span>Package</span>
            <span>Dialects</span>
            <span>Terminals</span>
            <span>Linker</span>
          </div>
          <div class="puffer-arrow" aria-hidden="true">↓</div>
          <div class="puffer-result">Diagnostics or completed products</div>
        </div>
      </div>
    </section>

    <section class="section section-bordered">
      <div class="container section-heading">
        <p class="subheader">Use the platform</p>
        <h2>Do not assemble the experience twice.</h2>
        <p>
          A hover, diagnostic, build, and Archive begin from the same view of
          the program. Puffer coordinates that journey while the semantic and
          product owners keep their real responsibilities.
        </p>
      </div>

      <div class="container principle-grid">
        {
          capabilities.map((capability) => (
            <article class="principle-card">
              <span>{capability.label}</span>
              <h3>{capability.title}</h3>
              <p>{capability.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="container callout puffer-optional">
        <div>
          <p class="subheader">Complete, not compulsory</p>
          <h2>Puffer is optional orchestration.</h2>
          <p>
            Build systems can call its command interface and editors can use its
            language server. A product that needs a different session can embed
            the Tetrodotoxin libraries directly and keep the same Package,
            compiler, Linker, and Archive behavior.
          </p>
        </div>
        <a class="button button-primary" href={SITE.puffer}>
          Explore the implementation
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
