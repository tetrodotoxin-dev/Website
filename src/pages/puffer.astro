---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const capabilities = [
  {
    label: 'Editor',
    title: 'Explore the real graph',
    copy: 'Hover, navigation, completion, highlighting, and formatting follow the identities and documentation the Dialect already created.',
  },
  {
    label: 'Products',
    title: 'Choose what the build needs',
    copy: 'Ask for native code, GPU modules, Archives, or another Terminal product when the completed Package is ready to produce it.',
  },
  {
    label: 'Sessions',
    title: 'One path for every caller',
    copy: 'Editors, terminals, and larger build systems can share one request path instead of carrying their own Package and compiler policy.',
  },
];
---

<BaseLayout
  title="Puffer · The complete Tetrodotoxin application"
  description="Puffer is Tetrodotoxin's all-in-one compiler driver, Workspace host, command interface, and language server."
>
  <main id="main">
    <section class="hero puffer-hero">
      <div class="container hero-content">
        <div class="hero-heading">
          <p class="subheader">Keep the whole project within reach</p>
          <h1 class="two-tone-title">
            <span>One front door</span>
            <span>For the whole toolchain</span>
          </h1>
        </div>

        <div class="hero-support">
          <div class="hero-copy">
            <p class="hero-summary">
              Open a Package once and keep the whole journey connected. Follow
              its meaning across every source, then build the products that
              belong to it without assembling another toolchain around the
              language.
            </p>
            <div class="button-row">
              <a class="button button-primary" href={SITE.puffer}>
                Browse Puffer
              </a>
              <a class="button button-secondary" href="/docs/core-concepts/">
                Platform guide
              </a>
            </div>
          </div>

          <div class="puffer-journey" aria-label="Editor, command line, and build system requests enter a Puffer session, use Tetrodotoxin owners, and return diagnostics or completed products">
            <p>Puffer request path</p>
            <div class="puffer-inputs">
              <span>Editor</span>
              <span>Command line</span>
              <span>Build system</span>
            </div>
            <div class="puffer-arrow" aria-hidden="true">↓</div>
            <div class="puffer-session">
              <small>One connected request path</small>
              <strong>Puffer session</strong>
            </div>
            <div class="puffer-arrow" aria-hidden="true">↓</div>
            <div class="puffer-owners">
              <span>Workspace</span>
              <span>Package</span>
              <span>Dialects</span>
              <span>Terminals</span>
              <span>Linker</span>
            </div>
            <div class="puffer-arrow" aria-hidden="true">↓</div>
            <div class="puffer-result">Diagnostics or completed products</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-bordered">
      <div class="container section-heading">
        <p class="subheader">From first edit to finished product</p>
        <h2 class="two-tone-title">
          <span>Understand the source</span>
          <span>Then build from it</span>
        </h2>
        <p>
          A new Dialect can feel useful as soon as it joins the Workspace.
          Puffer brings its identities into the editor and the build, so authors
          can spend their time shaping the language instead of rebuilding the
          toolchain around it.
        </p>
      </div>

      <div class="container principle-grid">
        {
          capabilities.map((capability) => (
            <article class="principle-card">
              <span>{capability.label}</span>
              <h3>{capability.title}</h3>
              <p>{capability.copy}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="container callout">
        <div>
          <p class="subheader">Complete when you want it</p>
          <h2 class="two-tone-title">
            <span>Start with the whole experience</span>
            <span>Keep every layer replaceable</span>
          </h2>
          <p>
            Puffer can meet a project as its editor host, command interface, and
            build front door together. When a product wants a different shell,
            the Tetrodotoxin libraries remain available underneath it, keeping
            the same Package, compiler, Linker, and Archive behavior while the
            experience changes around them.
          </p>
        </div>
        <a class="button button-primary" href={SITE.puffer}>
          Explore Puffer
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
