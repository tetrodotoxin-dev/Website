---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import ReferenceRouteTree from '../components/ReferenceRouteTree.astro';
import {
  findNode,
  graphHref,
  referenceRouteTree,
  referenceGraphs,
} from '../data/reference';

interface Props {
  title: string;
  description: string;
  activeGraph?: string;
}

const { title, description, activeGraph } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout title={`${title} · Tetrodotoxin Docs`} description={description}>
  <main id="main" class="docs-main reference-main">
    <div class="container docs-shell reference-shell">
      <DocsSidebar>
        <div class="reference-sidebar-heading"><span>Generated reference</span><strong>Packages</strong></div>
        <nav class="reference-package-navigation" aria-label="Package reference">
          {referenceGraphs.map((graph) => {
            const expanded = activeGraph === graph.slug;
            const root = findNode(graph.root);
            return (
              <div class="reference-package-branch">
                <details
                  class:list={['navigation-disclosure', { 'navigation-disclosure-active': expanded }]}
                  open={expanded}
                >
                  <summary>{root.displayName}</summary>
                  <div class="navigation-children reference-package-children">
                    <a
                      class="reference-package-overview"
                      href={graphHref(graph)}
                      aria-current={pathname === graphHref(graph) ? 'page' : undefined}
                    >Package overview</a>
                    <ReferenceRouteTree branches={referenceRouteTree(graph)} pathname={pathname} compact />
                  </div>
                </details>
              </div>
            );
          })}
        </nav>

      </DocsSidebar>

      <article class="docs-content reference-content">
        <header class="docs-header">
          <h1 class="accent">{title}</h1>
        </header>
        <div class="prose reference-prose"><slot /></div>
      </article>
    </div>
  </main>
</BaseLayout>
